{
  "manifest_version": 3,
  "name": "Code inject MV3",
  "version": "2026.10",
  "permissions": [
    "storage",
	"unlimitedStorage",
    "userScripts",
	"offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
        "128": "icon.png"
  }
}